# Gestionado por Ansible (homelab-k3s/ansible/roles/k3s_server). k3s lee este archivo al arrancar.
# El nodo se anuncia con su IP de la VPN y Flannel (la red de los pods) viaja por wg0, cifrado.
# El nodo se llama como en el inventario. El rol common ya pone ese hostname, pero así no depende
# del orden ni de que el hostname cambie: Ansible siempre lo encuentra por su nombre
node-name: {{ inventory_hostname }}
node-ip: {{ wireguard_ip }}
flannel-iface: {{ k3s_flannel_iface }}
