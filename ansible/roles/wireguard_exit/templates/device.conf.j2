# {{ item.name }}: salida a internet por EE. UU. Escanéala como QR con la app de WireGuard:
#   sudo qrencode -t ansiutf8 -r /etc/wireguard/clientes/{{ item.name }}.conf
[Interface]
PrivateKey = {{ wireguard_exit_device_private[item.name] }}
Address = {{ item.ip }}/32
DNS = {{ wireguard_exit_dns }}

[Peer]
PublicKey = {{ wireguard_exit_hub_public_key }}
Endpoint = {{ wireguard_endpoint }}:{{ wireguard_exit_port }}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
